# Copia este archivo a .env y llena los valores. .env NO se sube al repositorio.
# Formato: RT_<SECCION>__<CLAVE>. Sobrescribe lo que haya en config/settings.yaml.

# Archivo YAML alterno (opcional)
# RT_CONFIG_FILE=config/settings.yaml

RT_APP__ENTORNO=local

# Qdrant (en docker-compose el host es "qdrant")
RT_QDRANT__URL=http://localhost:6333
# RT_QDRANT__API_KEY=

# Servidor de embeddings compatible con OpenAI (/v1/embeddings): TEI, vLLM, Infinity...
RT_EMBEDDINGS__PROVIDER=openai_compatible
RT_EMBEDDINGS__BASE_URL=http://localhost:8081/v1
RT_EMBEDDINGS__MODEL=BAAI/bge-m3
RT_EMBEDDINGS__DIMENSION=1024
RT_EMBEDDINGS__API_KEY=

# LLM compatible con OpenAI. Por defecto Gemini (key de Google AI Studio).
# Alterno: vLLM/Ollama con Qwen3 (RT_LLM__BASE_URL=http://host:puerto/v1, RT_LLM__MODEL=Qwen/Qwen3-8B)
RT_LLM__PROVIDER=openai_compatible
RT_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RT_LLM__MODEL=gemini-3.5-flash-lite
RT_LLM__API_KEY=
# true solo para Qwen3 en vLLM/Ollama; Gemini no lo necesita
RT_LLM__DISABLE_THINKING=false

# Valor diario de la UMA (cambia cada 1 de febrero)
RT_UMA__VALOR_DIARIO=117.31
